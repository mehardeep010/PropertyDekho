# KYA HAI: Ye example env file hai. Isko copy karke '.env' banao aur apni values bharo.
#   cp .env.example .env   (ya Windows pe: copy .env.example .env)
# Asli .env git me commit NAHI hoti (.gitignore me hai) — secrets safe rehte hain.

# ── Server ──
NODE_ENV=development
PORT=3000
# Logging level: trace|debug|info|warn|error (dev me debug, prod me info recommended)
LOG_LEVEL=debug

# ── Database (MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=property_mgmt
DB_POOL_LIMIT=10

# ── Auth (JWT) ──
# Production me ye ek lamba random secret hona chahiye (default/blank chalega toh app crash hoga).
# Local dev (npm start) ke liye yahan apna secret bharo. Docker compose me agar ye blank chhoda
# toh compose ka non-default fallback use ho jaata hai (app crash nahi hota).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── AI price estimate (Gemini) — OPTIONAL ──
# Key na ho toh app theek chalta hai aur heuristic (comparable-based) fallback use hota hai.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
